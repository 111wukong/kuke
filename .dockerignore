# 构建镜像时不需要进上下文的东西。
# 少传一点 = 构建快一点，也不会把本机数据带进镜像。

node_modules
**/node_modules

# 构建产物 —— 镜像里会重新构建
web/dist
web/.tmp-fe-test

# 本地数据库与备份。★ 尤其重要：绝不能把开发数据打进生产镜像。
server/data
backups
*.db
*.db-wal
*.db-shm

# 环境与凭据
.env
.env.local

# 版本控制与编辑器
.git
.gitignore
.github
.vscode
.idea
.DS_Store

# 文档里的截图（README 用，镜像里用不到，省 5MB）
docs/screenshots

# 日志
*.log
